<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="800.0" prefHeight="648.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="InventoryController">
    <top>
    <HBox prefHeight="36.0" prefWidth="1060.0" spacing="40.0" BorderPane.alignment="CENTER_LEFT">
        <padding>
            <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
        </padding>
        <children>
            <Label fx:id="totalItemsLabel" prefHeight="24.0" prefWidth="220.0" text="Total items: 0">
                <font>
                <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <Label fx:id="totalValueLabel" prefHeight="24.0" prefWidth="280.0" text="Total value: Rs. 0.00">
                <font>
                <Font name="System Bold" size="12.0" />
                </font>
            </Label>
        </children>
    </HBox>
    </top>
   <center>
      <TableView fx:id="inventoryTable" minHeight="300.0" prefHeight="560.0" prefWidth="760.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="codeColumn" minWidth="60.0" text="Code" />
          <TableColumn fx:id="nameColumn" minWidth="150.0" prefWidth="300.0" text="Name" />
            <TableColumn fx:id="dealerColumn" minWidth="80.0" prefWidth="130.0" text="Dealer" />
            <TableColumn fx:id="priceColumn" minWidth="80.0" prefWidth="110.0" text="Price (Rs.)" />
            <TableColumn fx:id="qtyColumn" minWidth="50.0" prefWidth="70.0" text="Qty" />
            <TableColumn fx:id="categoryColumn" minWidth="80.0" prefWidth="130.0" text="Category" />
            <TableColumn fx:id="dateColumn" minWidth="90.0" prefWidth="110.0" text="Date" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <Label alignment="CENTER" prefHeight="28.0" prefWidth="1060.0" text="Sorted by category" textAlignment="CENTER" BorderPane.alignment="CENTER" />
   </bottom>
   <right>
      <VBox alignment="CENTER" prefHeight="560.0" prefWidth="300.0" spacing="6.0" BorderPane.alignment="TOP_CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <Label prefHeight="18.0" prefWidth="260.0" text="Code" />
            <TextField fx:id="codeField" prefHeight="28.0" prefWidth="260.0" promptText="e.g. P011" />
            <Label layoutX="30.0" layoutY="276.0" prefHeight="18.0" prefWidth="260.0" text="Name" />
            <TextField fx:id="nameField" layoutX="22.0" layoutY="288.0" prefHeight="28.0" prefWidth="260.0" promptText="Part name" />
            <Label layoutX="30.0" layoutY="305.0" prefHeight="18.0" prefWidth="260.0" text="Dealer" />
            <TextField fx:id="dealerField" layoutX="22.0" layoutY="317.0" prefHeight="28.0" prefWidth="260.0" promptText="Optional" />
            <Label layoutX="30.0" layoutY="334.0" prefHeight="18.0" prefWidth="260.0" text="Price (Rs.)" />
            <TextField fx:id="priceField" layoutX="22.0" layoutY="346.0" prefHeight="28.0" prefWidth="260.0" promptText="e.g. 1250.00" />
            <Label layoutX="30.0" layoutY="363.0" prefHeight="18.0" prefWidth="260.0" text="Quantity" />
            <TextField fx:id="qtyField" layoutX="22.0" layoutY="375.0" prefHeight="28.0" prefWidth="260.0" promptText="e.g. 10" />
            <Label layoutX="30.0" layoutY="392.0" prefHeight="18.0" prefWidth="260.0" text="Category" />
            <TextField fx:id="categoryField" layoutX="22.0" layoutY="404.0" prefHeight="28.0" prefWidth="260.0" promptText="ENGINE, BRAKES, etc" />
            <Label layoutX="30.0" layoutY="421.0" prefHeight="18.0" prefWidth="260.0" text="Date (yyyy-MM-dd)" />
            <TextField fx:id="dateField" layoutX="22.0" layoutY="433.0" prefHeight="28.0" prefWidth="260.0" promptText="2024-03-01" />
            <Label layoutX="30.0" layoutY="450.0" prefHeight="18.0" prefWidth="260.0" text="Image file" />
            <TextField fx:id="imageField" layoutX="22.0" layoutY="462.0" prefHeight="28.0" prefWidth="260.0" promptText="Optional filename" />
            <HBox alignment="CENTER" prefHeight="36.0" prefWidth="260.0" spacing="8.0">
               <children>
                  <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" prefHeight="30.0" prefWidth="58.0" text="Add" />
                  <Button fx:id="updateButton" mnemonicParsing="false" onAction="#onUpdate" prefHeight="30.0" prefWidth="68.0" text="Update" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#onDelete" prefHeight="30.0" prefWidth="62.0" text="Delete" />
                  <Button fx:id="clearButton" mnemonicParsing="false" onAction="#onClear" prefHeight="30.0" prefWidth="58.0" text="Clear" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>
</BorderPane>
