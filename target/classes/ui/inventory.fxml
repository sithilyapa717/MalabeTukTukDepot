<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="800.0" prefHeight="648.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="InventoryController">
    <top>
    <HBox prefHeight="36.0" prefWidth="1060.0" spacing="40.0" BorderPane.alignment="CENTER_LEFT">
        <padding>
            <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
        </padding>
        <children>
            <Label fx:id="totalItemsLabel" prefHeight="24.0" prefWidth="220.0" text="Total items: 0">
                <font>
                <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <Label fx:id="totalValueLabel" prefHeight="24.0" prefWidth="280.0" text="Total value: Rs. 0.00">
                <font>
                <Font name="System Bold" size="12.0" />
                </font>
            </Label>
        </children>
    </HBox>
    </top>
   <center>
      <TableView fx:id="inventoryTable" minHeight="300.0" prefHeight="560.0" prefWidth="1060.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="codeColumn" minWidth="60.0" text="Code" />
