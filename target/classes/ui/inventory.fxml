      </TableView>
   </center>
   <bottom>
      <Label alignment="CENTER" prefHeight="28.0" prefWidth="1060.0" text="Sorted by category" textAlignment="CENTER" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
