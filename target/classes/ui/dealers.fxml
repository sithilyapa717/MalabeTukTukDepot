<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="648.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DealerController">
   <top>
      <Label fx:id="selectedDealerLabel" prefHeight="36.0" prefWidth="1060.0" text="No dealer selected for POS" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="16.0" left="8.0" right="16.0" top="8.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <bottom>
      <HBox prefHeight="48.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="pickButton" mnemonicParsing="false" onAction="#onPickRandom" prefWidth="200.0" text="Pick 4 Random Dealers" />
            <Button fx:id="selectButton" mnemonicParsing="false" onAction="#onSelectDealer" prefWidth="160.0" text="Select for POS" />
         </children>
      </HBox>
   </bottom>
   <center>
      <TableView fx:id="dealerTable" minHeight="300.0" prefHeight="520.0" prefWidth="1060.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="idColumn" text="ID" />
          <TableColumn fx:id="nameColumn" prefWidth="280.0" text="Name" />
            <TableColumn fx:id="locationColumn" prefWidth="200.0" text="Location" />
            <TableColumn fx:id="phoneColumn" prefWidth="150.0" text="Phone" />
        </columns>
      </TableView>
   </center>
</BorderPane>
